{
  "expo": {
    "name": "Zaki",
    "slug": "zaki",
    "owner": "ai.zaki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zaki",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.zaki.tutor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF6FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zaki.tutor",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF6FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaki uses photos of school book pages that a parent chooses, to prepare a lesson. Please do not include faces or names.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": false,
      "eas": {
        "projectId": "6c405a9c-ac25-4a0e-afad-32b45183d2a0"
      }
    }
  }
}
